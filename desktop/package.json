{
  "name": "ury-pos-desktop",
  "productName": "URY POS",
  "version": "1.2.0",
  "description": "URY POS for Windows, with a built-in print agent for kitchen tickets and bills.",
  "main": "src/main.js",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.ury.pos",
    "productName": "URY POS",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "artifactName": "URY-POS-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
